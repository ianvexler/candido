# Local development: copy to .env (next to docker-compose.yml), which Docker Compose
# reads for the backend container. .env is git-ignored; keep real keys there only.

# Claude, for CV import and CV reviews. Without a key both report they're unavailable.
ANTHROPIC_API_KEY=
# Optional: the models they use (default claude-opus-5-5). A cheaper model keeps testing costs down.
# CV_TAILOR_MODEL=claude-opus-5-5
# CV_IMPORT_MODEL=claude-opus-5-5
